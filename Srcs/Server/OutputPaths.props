<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\out\$(ProjectName)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\..\out\$(ProjectName)\$(Configuration)\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
      <AdditionalOptions>/Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4996;5054;5055;4244;4242;4267;4838;4805;4146;4018;4309;4804;4101;4065;4477;4005;4834;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(ProjectDir)..\..\out\libthecore\$(Configuration);
        $(ProjectDir)..\..\out\libgame\$(Configuration);
        $(ProjectDir)..\..\out\libpoly\$(Configuration);
        $(ProjectDir)..\..\out\libsql\$(Configuration);
        $(ProjectDir)..\..\out\liblua\$(Configuration);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
