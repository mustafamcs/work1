# CMake çıktısı. vcpkg ağacı, third_party ve vendor depoya girmez (07).
/build/
/vcpkg/
/vcpkg_installed/
third_party/
vendor/

# Sırlar
.env
.env.*
*.pem
*.key
credentials.json

